# Sempre usar conexao segura (HTTPS). As duas condicoes evitam redirecionar em loop atras do proxy da hospedagem.
# No computador (localhost, XAMPP) fica em HTTP, porque o XAMPP nao tem certificado valido.
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Endereco proprio de cada loja: /loja/mercearia-do-ze abre o login daquela loja.
# %1 e a pasta do sistema ("/" no site, "/fiadofacil/" no XAMPP), para funcionar nos dois.
RewriteCond %{REQUEST_URI} ^(.*/)loja/([A-Za-z0-9-]+)/?$ [NC]
RewriteRule ^loja/ %1login.php?loja=%2 [NC,L,R=302,QSA]

# Pagina propria para enderecos que nao existem (vale no site e numa subpasta do XAMPP)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ 404.php [L]
ErrorDocument 404 /404.php

# Bloqueia o download direto de arquivos sensiveis (so tem efeito em servidores Apache)
<FilesMatch "\.(sql|md|txt)$|^config\.local\.example\.php$|^layout_publico\.php$|^migracoes\.php$|^desenhos\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
