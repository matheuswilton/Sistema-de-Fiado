# Pasta das fotos enviadas pelas lojas: so imagens. Nenhum script roda aqui e nao lista os arquivos.
Options -Indexes
<FilesMatch "\.(php|php\d|phtml|phar|pl|py|cgi|sh|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
